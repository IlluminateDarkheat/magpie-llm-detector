{
  "name": "magpie-llm-detector",
  "version": "0.1.0",
  "description": "Model fingerprint detection inside Magpie, with a plugin page and Agent tools powered by lmfpd-sdk",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": ["index.mjs", "src", "page/index.html", "page/app.js", "page/style.css", "page/icon.svg", "README.md"],
  "scripts": {
    "test": "bun test"
  },
  "keywords": ["magpie", "opencode", "opencode-plugin", "tools", "llm", "fingerprint", "lmfpd"],
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "lmfpd-sdk": "0.2.0"
  },
  "magpie": {
    "page": {
      "title": "Model fingerprint",
      "titles": { "zh": "模型 Fingerprint" },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": ["providers:list"],
    "actions": [
      { "id": "detect", "menu": "provider", "title": "Check fingerprints", "titles": { "zh": "检测 Fingerprint" } }
    ],
    "options": {
      "baseUrl": "http://127.0.0.1:3425/v1",
      "apiKeyEnv": "MAGPIE_DETECTOR_API_KEY"
    }
  }
}
